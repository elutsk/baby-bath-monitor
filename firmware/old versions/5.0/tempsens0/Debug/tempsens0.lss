                  .device ATtiny861A
                  .include	"F:\DIMA\chip\TempSens\tempsens0\tempsens0\tn861Adef.inc"
                 
                 ;***** Created: 2011-02-09 12:04 ******* Source: ATtiny861A.xml **********
                 ;*************************************************************************
                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                 ;* 
                 ;* Number            : AVR000
                 ;* File Name         : "tn861Adef.inc"
                 ;* Title             : Register/Bit Definitions for the ATtiny861A
                 ;* Date              : 2011-02-09
                 ;* Version           : 2.35
                 ;* Support E-mail    : avr@atmel.com
                 ;* Target MCU        : ATtiny861A
                 ;* 
                 ;* DESCRIPTION
                 ;* When including this file in the assembly program file, all I/O register 
                 ;* names and I/O register bit names appearing in the data book can be used.
                 ;* In addition, the six registers forming the three data pointers X, Y and 
                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                 ;* SRAM is also defined 
                 ;* 
                 ;* The Register names are represented by their hexadecimal address.
                 ;* 
                 ;* The Register Bit names are represented by their bit number (0-7).
                 ;* 
                 ;* Please observe the difference in using the bit names with instructions
                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                 ;* (skip if bit in register set/cleared). The following example illustrates
                 ;* this:
                 ;* 
                 ;* in    r16,PORTB             ;read PORTB latch
                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                 ;* out   PORTB,r16             ;output to PORTB
                 ;* 
                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                 ;* rjmp  TOV0_is_set           ;jump if set
                 ;* ...                         ;otherwise do something else
                 ;*************************************************************************
                 
                 #ifndef _TN861ADEF_INC_
                 #endif  /* _TN861ADEF_INC_ */
                 
                 ; ***** END OF FILE ******************************************************
                  .include	"F:\DIMA\chip\TempSens\tempsens0\tempsens0\mem_map.inc"
                 
                 .equ	t_out_key2 =0x61
                 .equ	t_out_key3 =0x62
                 
                 
                 .equ	code_keylo =0x63
                 .equ	code_keyhi =0x64
                 
                 .equ	code_templo =0x65
                 .equ	code_temphi =0x66
                 
                 .equ	code_waterlo =0x67
                 .equ	code_waterhi =0x68
                 
                 .equ	mv_templo =0x69
                 .equ	mv_temphi =0x6a
                 .equ	mv_temp_remains =0x6b
                 
                 .equ	tem_seg_h1 =0x6c
                 .equ	tem_seg_h2 =0x6d
                 .equ	tem_seg_h3 =0x6e
                 
                 
                 .equ	menu_seg_h1_r =0x6f
                 .equ	menu_seg_h2_r =0x70
                 .equ	menu_seg_h3_r =0x71
                 
                 .equ	menu_seg_h1 =0x72
                 .equ	menu_seg_h2 =0x73
                 .equ	menu_seg_h3 =0x74
                 
                 .equ	counter_power_off =0x75;
                 
                 .equ	beep_pause =0x76;
                 
                 .equ	fareng_tem =0x77
                 
                 .equ	const_water =0x78
                 
                 .equ	const_v_ref_hi =0x79
                 .equ	const_v_ref_lo =0x7a
                 
                 
                 .equ	counter_adc	=0x7b
                 
                 .equ	code_templo_temp =0x7c
                 .equ	code_temphi_temp =0x7d
                 
                 .equ	corr0_temp =0x7e
                 
                 .equ	key_pause_activ =0x7f
                 
                 .equ	wait3s_lo =0x80
                 .equ	wait3s_hi =0x81
                 
                 .equ	dev_log =0x83
                 
                 .equ	wait_menu_out_time_lo =0x84
                 .equ	wait_menu_out_time_hi =0x85
                 
                 .equ	code_battery =0x86
                 
                 .equ	delta_t	=0x87
                 
                 .equ	corr0_menu	=0x88
                 
                 .equ	corr_abs	=0x89
                 
                 .equ	timeout_key_lo	=0x8a
                 
                 .equ	timeout_key_hi	=0x8b
                 
                 .equ	var_timeout_key_lo	=0x8c
                 
                 .equ	var_timeout_key_hi	=0x8d
                 
                 .equ	key_povtor	=0x8e
                 
                 .equ	const_post_alarm  =0x8f
                 
                 .equ	beep_var =0x90 ;1-long1500  2-short1500  3-long600  4-short600
                 
                  
                  
                 
                 
                  .org	0x000
000000 c012       rjmp	start
                  
                   .org		0x0001	; External Interrupt 0
000001 9518        reti
                   .org		0x0002	; Pin Change Interrupt
000002 9518        reti
                   .org		0x0003	; Timer/Counter1 Compare Match 1A
000003 9518        reti
                   .org		0x0004	; Timer/Counter1 Compare Match 1B
000004 9518        reti
                   .org		0x0005	; Timer/Counter1 Overflow
000005 c5fc       rjmp	t1_int
                   .org		0x0006	; Timer/Counter0 Overflow
000006 c1c7      rjmp	 timer0
                   .org		0x0008	; USI Overflow
000008 9518        reti
                   .org		0x0009	; EEPROM Ready
000009 9518        reti
                   .org		0x000a	; Analog Comparator
00000a 9518        reti
                   .org		0x000b	; ADC Conversion Complete
00000b c3f5      rjmp	adc_conv ;reti
                   .org		0x000c	; Watchdog Time-Out
00000c c0ca      rjmp	Watchdog
                   .org		0x000d	; External Interrupt 1
00000d c385      rjmp	extint1
                   .org		0x000e	; Timer/Counter0 Compare Match A
00000e 9518        reti
                   .org		0x000f	; Timer/Counter0 Compare Match B
00000f 9518        reti
                   .org		0x0010	; Timer/Counter1
000010 9518       reti
                   .org		0x0011	; Timer/Counter1 Compare Match D
000011 9518        reti
                   .org		0x0012	; Timer/Counter1 Fault Protection
000012 9518        reti
                 
                 
                 
                  start:
                 
                 ; 
                 
                 
                 ;--------------------------------------- registr---------------
                 .def	mc16uL	=r16		;multiplicand low byte
