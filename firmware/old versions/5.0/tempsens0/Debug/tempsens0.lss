                 m_start:
000684 934f      	push	r20
000685 935f      	push	r21
                 
000686 2f40      	mov	R20,temp
                 
000687 0f44      	LSL	R20	; Сдвигом влево умножаем содержимое R20 на два.
                 			
                  
000688 e1ee      	LDI	ZL, low(menu_t1*2)	; Загружаем адрес нашей таблицы. Компилятор сам посчитает
000689 e0fc      	LDI	ZH, High(menu_t1*2)	; Умножение и запишет уже результат.Старший и младший байты.
                  
00068a 2755      	CLR	R21		; Сбрасываем регистр R21 - нам нужен ноль.
00068b 0fe4      	ADD	ZL, R20		; Складываем младший байт адреса. Если возникнет переполнение
00068c 1ff5      	ADC	ZH, R21		; То вылезет флаг переноса. Вторая команда складывает
                 				; с учетом переноса. Поскольку у нас R21=0, то по сути
                 				; мы прибавляем только флаг переноса. 				
                 				 
                  
00068d 9145      	LPM	R20,Z+		; Загрузили в R20 адрес из таблицы
00068e 9154      	LPM	R21,Z		; Старший и младший байт
                  
                  
00068f 01fa      	MOVW	 ZH:ZL,r21:r20		; забросили адрес в Z 
                 
000690 915f        pop	r21
000691 914f        pop	r20
                 
000692 9409      	IJMP	
