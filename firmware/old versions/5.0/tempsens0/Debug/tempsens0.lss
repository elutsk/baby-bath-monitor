                 ;-----------------------------------wdt_off pp-------------------------------------
                 
                 wdt_off:
0003ce 930f      push	temp
0003cf 936f      push	sreg_copy
0003d0 b76f      in	sreg_copy,sreg
0003d1 94f8      cli
                 
0003d2 95a8      wdr
                 	; Clear WDRF in MCUSR
0003d3 e000      ldi temp, (0<<WDRF)
0003d4 bf04      out MCUSR, temp
                 	; Write logical one to WDCE and WDE
                 	; Keep old prescaler setting to prevent unintentional Watchdog Reset
0003d5 b501      in  temp, WDTCSR
0003d6 6108      ori temp, (1<<WDCE)|(1<<WDE)
0003d7 bd01      out WDTCSR, temp
                 	; Turn off WDT
0003d8 e000      ldi temp, (0<<WDE)
0003d9 bd01      out WDTCSR, temp
0003da 9478      sei
0003db 0000      nop
0003dc 0000      nop
0003dd bf6f      out	sreg,sreg_copy
0003de 916f      pop	sreg_copy
0003df 910f      pop	temp
0003e0 9508      ret
                 
                 
                 
