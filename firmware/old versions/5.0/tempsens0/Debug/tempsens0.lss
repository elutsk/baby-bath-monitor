0003c4 95a8      	wdr
0003c5 e00d      	ldi	temp,0x0d
0003c6 bd01      	out	WDTCR,temp
                 
0003c7 e40e      	ldi	temp,restartwdt ;0X48 16 msec ,int en ;0X4d 500mSec
0003c8 bd01      	out	WDTCR,temp
0003c9 95a8      	wdr
                 
