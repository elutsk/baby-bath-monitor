                 .equ	ICEN0	= 6	; Input Capture Mode Enable
                 .equ	TCW0	= 7	; Timer/Counter 0 Width
                 
                 ; TCCR0B - Timer/Counter Control Register B
                 .equ	CS00	= 0	; Clock Select
                 .equ	CS01	= 1	; Clock Select
                 .equ	CS02	= 2	; Clock Select
