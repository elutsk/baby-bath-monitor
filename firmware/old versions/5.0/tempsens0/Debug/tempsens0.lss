                 ;file EEPROM tempsens0.eep--------------------------------
                 .ESEG 
                 
000000 04
000001 51        .db	0x04, 0x51; Vref = 1105mV(Up=3.3V) 
000002 28        .db	0x28	;sensitivity water sensor    
000003 0a        .db	0x0a	;corr0 ADC
000004 03        .db	0x03	;water sel
000005 28        .db	0x28	;temperature up
000006 00        .db	0x00	;temperature down
000007 00        .db	0x00	;si delta_t
000008 00        .db	0x00	;corr0_menu
000009 00        .db	0x00	;corr_abs
00000a 05        .db	0x05	;const lo time out key
00000b 00        .db	0x00	;const hi time out key
00000c 00        .db	0x00	;const_post_alarm  adrres 0x0c
                 ;--------------------------------------------
                 


RESOURCE USE INFORMATION
------------------------

Notice:
The register and instruction counts are symbol table hit counts,
and hence implicitly used resources are not counted, eg, the
'lpm' instruction without operands implicitly uses r0 and z,
none of which are counted.

x,y,z are separate entities in the symbol table and are
counted separately from r26..r31 here.

