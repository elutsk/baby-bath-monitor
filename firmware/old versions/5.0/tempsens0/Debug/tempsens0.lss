                 ;--===================ADC*Vref========= MUX 16X16_pp===========================================
                 
                 
                 ;***************************************************************************
                 ;*
                 ;* "mpy16u" - 16x16 Bit Unsigned Multiplication
                 ;*
                 ;* This subroutine multiplies the two 16-bit register variables 
                 ;* mp16uH:mp16uL and mc16uH:mc16uL.
                 ;* The result is placed in m16u3:m16u2:m16u1:m16u0.
                 ;*  
                 ;* Number of words	:14 + return
                 ;* Number of cycles	:153 + return
                 ;* Low registers used	:None
                 ;* High registers used  :7 (mp16uL,mp16uH,mc16uL/m16u0,mc16uH/m16u1,m16u2,
                 ;*                          m16u3,mcnt16u)	
                 ;*
                 ;***************************************************************************
                 
                 ;***** Subroutine Register Variables
                 
                 ;.def	mc16uL	=r16		;multiplicand low byte
                 ;.def	mc16uH	=r17		;multiplicand high byte
                 ;.def	mp16uL	=r18		;multiplier low byte
                 ;.def	mp16uH	=r19		;multiplier high byte
                 ;.def	m16u0	=r18		;result byte 0 (LSB)
                 ;.def	m16u1	=r19		;result byte 1
                 ;.def	m16u2	=r20		;result byte 2
                 ;.def	m16u3	=r23		;result byte 3 (MSB)
                 ;.def	mcnt16u	=r22		;loop counter
                 
                 
                 conv_adc_to_mV:
                 
000547 930f      push	r16
000548 931f      push	r17
000549 932f      push	r18
00054a 933f      push	r19
00054b 934f      push	r20
00054c 937f      push	r23;!!!
00054d 938f      push	r24
00054e 936f      push	sreg_copy
00054f b76f      in	sreg_copy,sreg
000550 936f      push	r22
                 
                 
                 
000551 9100 0065 lds	mc16uL,code_templo
000553 9110 0066 lds	mc16uH,code_temphi
                 ;nop
                 
                 
                 
000555 9120 007a lds	mp16uL,const_v_ref_lo;   ;0x35 Vref=1077mV / 0x4c Vref=1100mV
000557 9130 0079 lds	mp16uH,const_v_ref_hi
                 
                 
                 
000559 2777      	clr	m16u3		;clear 2 highest bytes of result
00055a 2744      	clr	m16u2
00055b e160      	ldi	mcnt16u,16	;init loop counter
00055c 9536      	lsr	mp16uH
00055d 9527      	ror	mp16uL
                 
00055e f410      m16u_1:	brcc	noad8		;if bit 0 of multiplier set
00055f 0f40      	add	m16u2,mc16uL	;add multiplicand Low to byte 2 of res
000560 1f71      	adc	m16u3,mc16uH	;add multiplicand high to byte 3 of res
000561 9577      noad8:	ror	m16u3		;shift right result byte 3
000562 9547      	ror	m16u2		;rotate right result byte 2
000563 9537      	ror	m16u1		;rotate result byte 1 and multiplier High
000564 9527      	ror	m16u0		;rotate result byte 0 and multiplier Low
000565 956a      	dec	mcnt16u		;decrement loop counter
000566 f7b9      	brne	m16u_1		;if not done, loop more
                 
                 	;mov	lo_tem,m16u0
                 	;mov	hi_tem,m16u1
                 
                 
                 
                 ;div 4
000567 9546      	lsr	m16u2
000568 9537      	ror	m16u1
000569 9527      	ror	m16u0
                 
00056a 9546      	lsr	m16u2
00056b 9537      	ror	m16u1
00056c 9527      	ror	m16u0
                 
                 
                 
                 ;div 4 (interpoly)
00056d 9546      	lsr	m16u2
00056e 9537      	ror	m16u1
                 
00056f 9546      	lsr	m16u2
000570 9537      	ror	m16u1
                 
                 	;lsr	m16u2
                 	;ror	m16u1
                 
                 
000571 9330 0069 	sts	mv_templo,m16u1
000573 0000      	nop
                 
000574 9340 006a 	sts	mv_temphi,m16u2
000576 0000      	nop
                 	
                 
                 
                 
                 ;----------------------conv_mv_dec7-------
                 
                 .def	hi_tem =r16
                 .def	lo_tem =r17
                 .def	cili_t =r18
                 .def	drobni_t =r19
                 .def	seg1	=r23
                 .def	seg2	=r24
                 
                 
000577 9110 0069 	lds	lo_tem,mv_templo
000579 0000      	nop
00057a 9100 006a 	lds	hi_tem,mv_temphi
00057c 0000      	nop
                 	
                 
00057d 2722      	clr	cili_t
00057e 2733      	clr	drobni_t
00057f 2777      	clr	seg1
000580 2788      	clr	seg2
                 
                 
                 
000581 3c18      	cpi	lo_tem,0xc8
000582 f428      	brsh	dvisti
000583 3614      	cpi	lo_tem,0x64
000584 f440      	brsh	sto
000585 3312      	cpi	lo_tem,0x32
000586 f458      	brsh	polsta
000587 c00f      	rjmp	start_lo_t
                 
                 
                 dvisti:
000588 ec68      	ldi	r22,0xc8
000589 1b16      	sub	lo_tem,r22
00058a e164      	ldi	r22,0x14
00058b 0f26      	add	cili_t,r22
00058c c00a      	rjmp	start_lo_t
                 
                 
                 sto:
00058d e664      	ldi	r22,0x64
00058e 1b16      	sub	lo_tem,r22
00058f e06a      	ldi	r22,0x0a
000590 0f26      	add	cili_t,r22
000591 c005      	rjmp	start_lo_t
                 
                 
                 polsta:
000592 e362      	ldi	r22,0x32
000593 1b16      	sub	lo_tem,r22
000594 e065      	ldi	r22,0x05
000595 0f26      	add	cili_t,r22
000596 c000      	rjmp	start_lo_t
                 
                 
                 
                 start_lo_t:	
000597 301a      	cpi	lo_tem,0xa
000598 f018      	brlo	end_lo_t
000599 501a      	subi	lo_tem,0xa
00059a 9523      	inc	cili_t
00059b cffb      	rjmp	start_lo_t
                 end_lo_t:
00059c 0f31      	add	drobni_t,lo_tem
00059d 303a      	cpi	drobni_t,0xA
00059e f010      	brlo	drobni_t_end
00059f 503a      	subi	drobni_t,0xA
0005a0 9523      	inc	cili_t
                 drobni_t_end:
0005a1 3001      	cpi	hi_tem,0x1
0005a2 f028      	brlo	hi_t_end
0005a3 950a      	dec	hi_tem
                 
                 	;ldi	lo_tem,0xff
                 
0005a4 e016      	ldi	lo_tem,0x6
                 
0005a5 e169      	ldi	r22,0x19
0005a6 0f26      	add	cili_t,r22
                 
0005a7 cfef      	rjmp	start_lo_t
                 
                 
                 hi_t_end:
                 
                                                                                            
                 ;---------------------------------------
                 
                 
