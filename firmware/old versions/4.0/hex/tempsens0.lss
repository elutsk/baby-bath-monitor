000579 e01b      ldi	r17,sym_H
00057a 9310 0072 sts	menu_seg_h1,r17
                 
00057c e02c      ldi	r18,sym_I
00057d 9320 0073 sts	menu_seg_h2,r18
                 
00057f e01a      ldi	r17,blank
000580 9310 0074 sts	menu_seg_h3,r17
                 
000582 2799      clr	keyboard_code
                 
000583 c0fc      	rjmp	end_menu
                 
                 
                 start_time_1sec:
