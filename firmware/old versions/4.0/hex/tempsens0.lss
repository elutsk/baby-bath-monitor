0005ae f048      	brlo	menu_seg3
0005af 501a      	subi	r17,0x0a
                 
0005b0 9120 0073 	lds	r18,menu_seg_h2
0005b2 0000      	nop
0005b3 9523      	inc	r18
0005b4 9320 0073 	sts	menu_seg_h2,r18
0005b6 0000      	nop
0005b7 cff5      	rjmp	menu_seg2
                 menu_seg3:
