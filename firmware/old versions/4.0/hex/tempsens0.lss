                 menu:
000545 933f      push	r19
000546 932f      push	r18
000547 931f      push	r17
000548 930f      PUSH	TEMP
000549 936f      push	sreg_copy
00054a b76f      in	sreg_copy,sreg
                 
                 
                 
00054b 2d06      mov	temp,menu_step
00054c 3000      	cpi	temp,0x00
00054d f009      	breq	wait_enter
00054e c003      	rjmp	m_start
                 
                 wait_enter:
                 	
00054f 3892      	cpi	keyboard_code,0x82
000550 f009      	breq	m_start
000551 c12e      	rjmp	end_menu
                 
                 m_start:
000552 934f      	push	r20
000553 935f      	push	r21
                 
000554 2f40      	mov	R20,temp
                 
000555 0f44      	LSL	R20	; Сдвигом влево умножаем содержимое R20 на два.
                 			
                  
000556 e2ec      	LDI	ZL, low(menu_t1*2)	; Загружаем адрес нашей таблицы. Компилятор сам посчитает
000557 e0fa      	LDI	ZH, High(menu_t1*2)	; Умножение и запишет уже результат.Старший и младший байты.
                  
000558 2755      	CLR	R21		; Сбрасываем регистр R21 - нам нужен ноль.
000559 0fe4      	ADD	ZL, R20		; Складываем младший байт адреса. Если возникнет переполнение
00055a 1ff5      	ADC	ZH, R21		; То вылезет флаг переноса. Вторая команда складывает
                 				; с учетом переноса. Поскольку у нас R21=0, то по сути
                 				; мы прибавляем только флаг переноса. 				
                 				 
                  
00055b 9145      	LPM	R20,Z+		; Загрузили в R20 адрес из таблицы
00055c 9154      	LPM	R21,Z		; Старший и младший байт
                  
                  
00055d 01fa      	MOVW	 ZH:ZL,r21:r20		; забросили адрес в Z 
                 
00055e 915f        pop	r21
00055f 914f        pop	r20
                 
000560 9409      	IJMP		
                 
                 
                 
                 disp_sec:;--------------
000561 9503      	inc	temp;counter menu
                 
000562 e015      	ldi	r17,sym_S
000563 9310 0072 	sts	menu_seg_h1,r17
                 
000565 e02e      	ldi	r18,sym_E
000566 9320 0073 	sts	menu_seg_h2,r18
                 
000568 e110      	ldi	r17,sym_n
000569 9310 0074 	sts	menu_seg_h3,r17
                 
00056b 2799      	clr	keyboard_code
                 
00056c c113      	rjmp	end_menu
                 ;--------------------------
                 
                 copy_const_water_sens:
                 
                 
