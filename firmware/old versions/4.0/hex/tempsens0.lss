                 not_blank_displ1:
                 
                 
0005e1 3892      	cpi	keyboard_code,0x82
0005e2 f039      	breq	enter_menu
0005e3 3795      	cpi	keyboard_code,0x75
0005e4 f069      	breq	up_menu
0005e5 369a      	cpi	keyboard_code,0x6a
0005e6 f091      	breq	down_menu
0005e7 359e      	cpi	keyboard_code,0x5e
0005e8 f0b9      	breq	back_menu
                 
                 
0005e9 c096      	rjmp	end_menu
                 
                 enter_menu:;---------
