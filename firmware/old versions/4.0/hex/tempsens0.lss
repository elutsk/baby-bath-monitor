00056f 2cab      	mov	const,const_et
000570 9503      	inc	temp
000571 c10e      	rjmp	end_menu
                 
                 
                 
                 save_const_water_sens:
                 
000572 9503      	inc	temp
000573 92a0 0078 	sts	const_water,const
000575 c10a      	rjmp	end_menu
                 
                 
                 start_menu:
                 
                 
