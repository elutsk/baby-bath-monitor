                 ;-----------------------------------wdt_off pp-------------------------------------
                 
                 wdt_off:
0002e9 930f      push	temp
0002ea 936f      push	sreg_copy
0002eb b76f      in	sreg_copy,sreg
0002ec 94f8      cli
                 
0002ed 95a8      wdr
                 	; Clear WDRF in MCUSR
0002ee e000      ldi temp, (0<<WDRF)
0002ef bf04      out MCUSR, temp
                 	; Write logical one to WDCE and WDE
                 	; Keep old prescaler setting to prevent unintentional Watchdog Reset
0002f0 b501      in  temp, WDTCSR
0002f1 6108      ori temp, (1<<WDCE)|(1<<WDE)
0002f2 bd01      out WDTCSR, temp
                 	; Turn off WDT
0002f3 e000      ldi temp, (0<<WDE)
0002f4 bd01      out WDTCSR, temp
0002f5 9478      sei
0002f6 0000      nop
0002f7 0000      nop
0002f8 bf6f      out	sreg,sreg_copy
0002f9 916f      pop	sreg_copy
0002fa 910f      pop	temp
0002fb 9508      ret
                 
                 
                 
