00049c 1b16      	sub	lo_tem,r22
00049d e065      	ldi	r22,0x05
00049e 0f26      	add	cili_t,r22
00049f c000      	rjmp	start_lo_t
                 
                 
                 
                 start_lo_t:	
0004a0 301a      	cpi	lo_tem,0xa
0004a1 f018      	brlo	end_lo_t
0004a2 501a      	subi	lo_tem,0xa
0004a3 9523      	inc	cili_t
0004a4 cffb      	rjmp	start_lo_t
                 end_lo_t:
