0005f5 94a3      	inc	const
                 skip_inc:
0005f6 2799      	clr	keyboard_code
                 	
0005f7 5001      	subi	temp,0x1
0005f8 c087      	rjmp	end_menu
                 down_menu:;-------------
                 
                 
                 
