                 ;--===================ADC*Vref========= MUX 16X16_pp===========================================
                 
                 
                 ;***************************************************************************
                 ;*
                 ;* "mpy16u" - 16x16 Bit Unsigned Multiplication
                 ;*
                 ;* This subroutine multiplies the two 16-bit register variables 
                 ;* mp16uH:mp16uL and mc16uH:mc16uL.
                 ;* The result is placed in m16u3:m16u2:m16u1:m16u0.
                 ;*  
                 ;* Number of words	:14 + return
                 ;* Number of cycles	:153 + return
                 ;* Low registers used	:None
                 ;* High registers used  :7 (mp16uL,mp16uH,mc16uL/m16u0,mc16uH/m16u1,m16u2,
                 ;*                          m16u3,mcnt16u)	
                 ;*
                 ;***************************************************************************
                 
                 ;***** Subroutine Register Variables
                 
                 ;.def	mc16uL	=r16		;multiplicand low byte
                 ;.def	mc16uH	=r17		;multiplicand high byte
                 ;.def	mp16uL	=r18		;multiplier low byte
                 ;.def	mp16uH	=r19		;multiplier high byte
                 ;.def	m16u0	=r18		;result byte 0 (LSB)
                 ;.def	m16u1	=r19		;result byte 1
                 ;.def	m16u2	=r20		;result byte 2
                 ;.def	m16u3	=r23		;result byte 3 (MSB)
                 ;.def	mcnt16u	=r22		;loop counter
                 
                 
                 conv_adc_to_mV:
                 
000450 930f      push	r16
000451 931f      push	r17
000452 932f      push	r18
000453 933f      push	r19
000454 934f      push	r20
000455 937f      push	r23;!!!
000456 938f      push	r24
000457 936f      push	sreg_copy
000458 b76f      in	sreg_copy,sreg
000459 936f      push	r22
                 
                 
                 
00045a 9100 0065 lds	mc16uL,code_templo
00045c 9110 0066 lds	mc16uH,code_temphi
                 ;nop
                 
                 
                 
00045e 9120 007a lds	mp16uL,const_v_ref_lo;   ;0x35 Vref=1077mV / 0x4c Vref=1100mV
000460 9130 0079 lds	mp16uH,const_v_ref_hi
                 
                 
                 
000462 2777      	clr	m16u3		;clear 2 highest bytes of result
000463 2744      	clr	m16u2
000464 e160      	ldi	mcnt16u,16	;init loop counter
000465 9536      	lsr	mp16uH
000466 9527      	ror	mp16uL
                 
000467 f410      m16u_1:	brcc	noad8		;if bit 0 of multiplier set
000468 0f40      	add	m16u2,mc16uL	;add multiplicand Low to byte 2 of res
000469 1f71      	adc	m16u3,mc16uH	;add multiplicand high to byte 3 of res
00046a 9577      noad8:	ror	m16u3		;shift right result byte 3
00046b 9547      	ror	m16u2		;rotate right result byte 2
00046c 9537      	ror	m16u1		;rotate result byte 1 and multiplier High
00046d 9527      	ror	m16u0		;rotate result byte 0 and multiplier Low
00046e 956a      	dec	mcnt16u		;decrement loop counter
00046f f7b9      	brne	m16u_1		;if not done, loop more
                 
                 	;mov	lo_tem,m16u0
                 	;mov	hi_tem,m16u1
                 
                 
                 
                 ;div 4
000470 9546      	lsr	m16u2
