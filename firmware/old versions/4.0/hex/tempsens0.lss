                 	;counter menu timeout, to end menu------------------
0005c7 931f      	push	r17
0005c8 930f      	push	r16
                 
                 
0005c9 9110 0085 	lds	r17,wait_menu_out_time_hi
0005cb 9100 0084 	lds	r16,wait_menu_out_time_lo
0005cd 0000      	nop
                 
0005ce 5001      	subi	r16,0x1
0005cf 4010      	sbci	r17,0x0
                 
0005d0 3e11      	cpi	r17,0xe1;~30sec!!!
0005d1 f009      	breq	menu_out
0005d2 c006      	rjmp	save_wait_count
                 
                 
                 menu_out:
0005d3 910f      	pop	r16;!!!!
                 
0005d4 2700      	clr	r16;!!!!clr menu step
                 
0005d5 930f      	push	r16;!!!
                 
                 
