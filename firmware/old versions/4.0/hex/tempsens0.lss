0004a8 503a      	subi	drobni_t,0xA
0004a9 9523      	inc	cili_t
                 drobni_t_end:
0004aa 3001      	cpi	hi_tem,0x1
0004ab f028      	brlo	hi_t_end
0004ac 950a      	dec	hi_tem
                 
                 	;ldi	lo_tem,0xff
                 
0004ad e016      	ldi	lo_tem,0x6
                 
0004ae e169      	ldi	r22,0x19
0004af 0f26      	add	cili_t,r22
                 
0004b0 cfef      	rjmp	start_lo_t
                 
                 
                 hi_t_end:
                 
                                                                                            
