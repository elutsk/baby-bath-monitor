                 t0_table_start:
                 
                 
0001b2 934f      	push	r20
0001b3 935f      	push	r21
                 
0001b4 2d45      	mov	R20,t0_table_step
                 
0001b5 0f44      	LSL	R20	; Сдвигом влево умножаем содержимое R20 на два.
                 			
                  
0001b6 e4e8      	LDI	ZL, low(t0_table*2)	; Загружаем адрес нашей таблицы. Компилятор сам посчитает
0001b7 e0f3      	LDI	ZH, High(t0_table*2)	; Умножение и запишет уже результат.Старший и младший байты.
                  
0001b8 2755      	CLR	R21		; Сбрасываем регистр R21 - нам нужен ноль.
0001b9 0fe4      	ADD	ZL, R20		; Складываем младший байт адреса. Если возникнет переполнение
0001ba 1ff5      	ADC	ZH, R21		; То вылезет флаг переноса. Вторая команда складывает
                 				; с учетом переноса. Поскольку у нас R21=0, то по сути
                 				; мы прибавляем только флаг переноса. 				
                 				 
                  
0001bb 9145      	LPM	R20,Z+		; Загрузили в R20 адрес из таблицы
0001bc 9154      	LPM	R21,Z		; Старший и младший байт
                  
                  
0001bd 01fa      	MOVW	 ZH:ZL,r21:r20		; забросили адрес в Z 
                 
0001be 915f      	pop	r21
0001bf 914f      	pop	r20
                 
0001c0 9409      	IJMP
                 
